---
import Button from "../components/Button.astro";
import Column from "../components/Column.astro";
import Modal from "../components/Modal.astro";
import Row from "../components/Row.astro";
import CopySimple from "../../components/CopySimple.astro";

interface Sugerencias {
	nombre: string;
	lista_regalos_url: string;
	lista_regalos_codigo: string;
	numero_billetera_digital: string;
	numero_banco: string;
	cci: string;
}

interface Props {
	sugerencias: Sugerencias;
}

const { sugerencias } = Astro.props;
---

<Column
	class='bg-[url(/backgrounds/gift-desktop.webp)] max-lg:bg-[url(/backgrounds/gift-mobile.webp)] bg-no-repeat bg-cover bg-top-right py-12 w-full text-center font-primary'
	mainAxisAlignment='center'
	crossAxisAlignment='center'
>
	<Modal
		id='gift-modal'
		triggerId='open-gift-modal'
	>
		<Column
			class='relative w-10/12 lg:w-1/3 rounded-lg py-8 px-6 bg-white shadow-lg gap-4'
			mainAxisAlignment='center'
			crossAxisAlignment='center'
		>
			<button class='close-modal absolute top-0 right-0 font-bold text-primary w-10 h-10 border-none cursor-pointer bg-transparent'>
				<span class='text-3xl'>×</span>
			</button>

			<!-- Logo Falabella -->
			<img
				src='/images/Falabella.svg'
				alt='Falabella'
				class='h-10 lg:h-12 object-contain w-full'
			/>

			<p class='text-sm text-primary-neutral text-center leading-relaxed'>
				Tenemos una lista de regalos en Novios Falabella.<br/>
				Puedes visitarla con el siguiente enlace y código:
			</p>

			<!-- Código con botón copiar -->
			<div class='flex flex-col items-center gap-1 w-full'>
				<span class='text-xs text-primary-neutral uppercase tracking-wider'>Código de lista</span>
				<Row
					class='gap-2 font-bold text-lg text-primary'
					mainAxisAlignment='center'
					crossAxisAlignment='center'
				>
					<span>{sugerencias.lista_regalos_codigo}</span>
					<CopySimple mensajeACopiar={sugerencias.lista_regalos_codigo} />
				</Row>
			</div>

			<!-- Botón ir a Falabella -->
			<a
				href={sugerencias.lista_regalos_url}
				target='_blank'
				rel='noopener noreferrer'
				class='w-full'
			>
				<Button
					type='button'
					class='w-full'
					label='Ver lista de regalos →'
				/>
			</a>

			<button class='close-modal text-xs text-primary-neutral underline cursor-pointer border-none bg-transparent mt-1'>
				Cerrar
			</button>
		</Column>
	</Modal>


	<Column
		mainAxisAlignment='center'
		crossAxisAlignment='center'
		data-sal='slide-up'
		data-sal-duration='800'
		class='bg-white/66 shadow-[0_0_5px_rgba(0,0,0,0.65)] p-4 py-12 rounded-lg w-4/5 lg:w-lg text-center gap-4 lg:gap-5'
	>
		<img
			class='h-12.5 lg:h-15'
			src='/icons/gift.svg'
			alt='gift'
		/>
		<h2 class='text-2xl lg:text-4xl font-display font-semibold text-primary'>Mesa de Regalos</h2>
		<p class='max-lg:text-sm text-primary-neutral leading-relaxed'>El mejor regalo es que estés presente en este día tan esperado, pero si deseas hacernos un obsequio tenemos estas opciones:</p>
		<Button
			id='open-gift-modal'
			label='Ver sugerencias'
		/>
	</Column>
</Column>

<script>
	// Modal logic is now handled by the Modal component.
</script>
