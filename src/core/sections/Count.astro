---
import Column from "../components/Column.astro";
import Row from "../components/Row.astro";

interface Props {
	pases: number;
}

const { pases } = Astro.props;
---

<Column
	class='gap-3 text-xl lg:text-3xl bg-surface-green py-12 lg:py-14 text-primary-neutral font-primary'
	data-sal='slide-up'
	mainAxisAlignment='center'
	crossAxisAlignment='center'
	data-sal-duration='800'
>
	Hemos reservado
	<Row class='gap-5'>
		{
			Array.from({ length: 5 }, (_, index) => (
				<Column
					mainAxisAlignment='center'
					crossAxisAlignment='center'
				>
					<span class='max-lg:text-sm text-base'>{index + 1}</span>
					<div class={`w-7 h-7 lg:w-10 lg:h-10 rounded-full border border-brand-green ${index < pases ? "bg-brand-green" : ""}`} />
				</Column>
			))
		}
	</Row>
	Lugares en tu honor
</Column>
