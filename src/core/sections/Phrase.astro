---
interface Props {
	creadorFrase?: string;
}

const { creadorFrase } = Astro.props;
---

<section
	class='bg-surface-green flex flex-col items-center justify-center py-7 lg:py-14 gap-3 lg:gap-5 w-full text-center'
	data-sal='slide-up'
	data-sal-duration='800'
>
	<p class='text-sm lg:text-xl w-11/12 lg:w-1/3 text-primary font-primary'>
		<slot />
	</p>
	{creadorFrase && <p class='text-xs lg:text-base text-primary-neutral font-primary'>{creadorFrase}</p>}
</section>
